rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null || true; // Supports both Firebase Auth & Student ID sessions
    }

    function isTeacher() {
      return request.auth != null && (
        request.auth.token.email == 'teacher@karma.edu.bt' ||
        request.auth.uid.matches('(?i).*teacher.*') ||
        request.auth.uid.matches('(?i).*educator.*')
      );
    }

    function isValidString(str, minLen, maxLen) {
      return str is string && str.size() >= minLen && str.size() <= maxLen;
    }

    // 1. Students collection
    match /students/{studentId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['studentId', 'name', 'role']) &&
                       request.resource.data.role == 'student' &&
                       isValidString(request.resource.data.name, 1, 100) &&
                       isValidString(request.resource.data.studentId, 1, 100);
      allow update: if true;
      allow delete: if true;
    }

    // 2. Classroom Help Requests
    match /classroom_help_requests/{requestId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['studentName', 'query']) &&
                       isValidString(request.resource.data.studentName, 1, 100) &&
                       isValidString(request.resource.data.query, 1, 3000);
      allow update: if true;
      allow delete: if true;
    }

    // 3. Teacher Notes
    match /teacherNotes/{noteId} {
      allow read, write: if true;
    }

    // 4. Active Sessions (Study Room Presence)
    match /active_sessions/{sessionId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['studentName']) &&
                               isValidString(request.resource.data.studentName, 1, 100);
      allow delete: if true;
    }

    // 5. Community Cheers
    match /community_cheers/{cheerId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['senderName', 'recipientName', 'cheerText']) &&
                       isValidString(request.resource.data.senderName, 1, 100) &&
                       isValidString(request.resource.data.recipientName, 1, 100) &&
                       isValidString(request.resource.data.cheerText, 1, 500);
      allow update, delete: if true;
    }

    // 6. Peer Review Requests
    match /peer_review_requests/{requestId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['studentName', 'projectTitle', 'codeSnippet']) &&
                       isValidString(request.resource.data.studentName, 1, 100) &&
                       isValidString(request.resource.data.projectTitle, 1, 200) &&
                       isValidString(request.resource.data.codeSnippet, 1, 15000);
      allow update: if true;
      allow delete: if true;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}


